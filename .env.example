# 이 파일을 .env 로 복사한 뒤 값을 채운다. 실제 키는 이 파일에 적지 않는다.

# Amazon Bedrock (LLM: ChatBedrockConverse, 임베딩: Titan Text Embeddings v2)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=

# LangSmith 트레이스
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=

# 날짜 검증 기준일 (YYYY-MM-DD, KST). 비우면 실제 오늘 날짜를 쓴다.
# 평가(round1·round2)는 같은 기준일로 실행한다: 2026-11-12
VISIT_REFERENCE_DATE=
